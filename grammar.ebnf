(* NL is the end of a line. The lexer delivers tokens grouped by line, so line ends are not tokens; blank lines are skipped. *)
(* A simple statement is one line; an if is several: the condition line, the "{" line, every line of the block, the "}" line. *)
(* A struct is several lines too: the "struct" line, the "{" line, one line per field, the "}" line. *)
(* Terminals: "i32" "i64" "bool" "mut" "exit" "true" "false" "if" "else" "while" "struct" "fn" are keyword tokens, "{" is lbrace, "}" is rbrace, "," is comma, "(" is lparen, ")" is rparen, "->" is arrow, *)
(* ":=" "+" "-" "*" "==" "!=" "!" are operator tokens, ident and number are ident and number tokens. *)
(* Precedence, tightest first: factor (including "!"), term (*), arith (+ -), expr (== !=, at most one per expression). *)

program   ::= { struct } { fn } { statement } exit
struct    ::= "struct" ident NL "{" NL field_decl { field_decl } "}" NL
field_decl ::= type [ "mut" ] ident NL
fn        ::= "fn" ident ":=" "(" [ type ident { "," type ident } ] ")" "->" type NL block
statement ::= decl | assign | if | while
decl      ::= type [ "mut" ] ident "{" expr { "," expr } "}"          (* a built-in type takes one value, a struct one per field *)
type      ::= "i32" | "i64" | "bool" | ident                          (* ident: a struct declared above *)
assign    ::= ident ":=" expr
if        ::= "if" expr NL block [ "else" NL block ]
while     ::= "while" expr NL block
block     ::= "{" NL { statement } [ exit NL ] "}" NL          (* not empty *)
exit      ::= "exit" factor
expr      ::= arith [ ( "==" | "!=" ) arith ]
arith     ::= term { ( "+" | "-" ) term }
term      ::= factor { "*" factor }
call      ::= ident "(" [ expr { "," expr } ] ")"
factor    ::= number | "true" | "false" | ident | call | "!" factor
