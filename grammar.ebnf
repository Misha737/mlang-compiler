(* One statement per line. The lexer delivers tokens grouped by line, so line ends are not tokens; blank lines are skipped. *)
(* Terminals: "i32" "i64" "bool" "mut" "exit" "true" "false" are keyword tokens, "{" is lbrace, "}" is rbrace, *)
(* ":=" "+" "-" "*" "==" "!=" are operator tokens, ident and number are ident and number tokens. *)
(* Precedence, tightest first: factor, term (*), arith (+ -), expr (== !=, at most one per expression). *)

program   ::= { statement } exit
statement ::= decl | assign
decl      ::= type [ "mut" ] ident "{" expr "}"
type      ::= "i32" | "i64" | "bool"
assign    ::= ident ":=" expr
exit      ::= "exit" factor
expr      ::= arith [ ( "==" | "!=" ) arith ]
arith     ::= term { ( "+" | "-" ) term }
term      ::= factor { "*" factor }
factor    ::= number | "true" | "false" | ident
