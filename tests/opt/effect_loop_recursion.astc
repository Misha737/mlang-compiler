Program
  Fn count i32
    Param n i32
    Block
      Decl i i32 mut
        Const 0
      While
        BinOp !=
          Var i
          Var n
        Block
          Assign i
            BinOp +
              Var i
              Const 1
      Exit
        Var i
  Fn down i32
    Param n i32
    Block
      Decl r i32 mut
        Const 0
      If
        BinOp !=
          Var n
          Const 0
        Block
          Assign r
            Call down
              BinOp -
                Var n
                Const 1
      Exit
        Var r
  Decl a i32 const
    Call count
      Const 3
  Decl b i32 const
    Call down
      Const 3
  Decl c i32 const
    Const 7
  Print
    Var c
  Exit
    Const 0
